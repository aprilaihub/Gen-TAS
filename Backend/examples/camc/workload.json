      "input": {
        "name": "histogram",
        "cpp_type": "histogram_t",
        "bits_per_element": 14,
        "length": 10000,
        "shape_expression": "CAMC_HISTOGRAM_SIZE",
        "semantic": "constellation_histogram",
        "test_expression": "histogram_t((i * 13 + 7) & 0x3FFF)"
      },
      "output": {
        "name": "scores",
        "cpp_type": "score_t",
        "bits_per_element": 64,
        "length": 4,
        "shape_expression": "CAMC_SCORE_COUNT",
