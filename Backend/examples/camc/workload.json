        "bits_per_element": 8,
        "length": 1600,
        "shape_expression": "CAMC_COORDINATE_SIZE",
        "semantic": "quantized_x_y_coordinates",
        "test_expression": "coordinate_t((i * 37 + 1) % CAMC_GRID_SIZE)"
      },
      "output": {
        "name": "histogram",
        "cpp_type": "histogram_t",
        "bits_per_element": 14,
        "length": 10000,
        "shape_expression": "CAMC_HISTOGRAM_SIZE",
        "semantic": "constellation_histogram"
      }
    },
    "S3": {
      "function": "array_product",
      "source": "src/sub_3_array_product.cpp",
