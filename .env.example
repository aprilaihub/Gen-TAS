# GenTAS ELM Configuration
# Copy this file to .env and insert your own API key.
# Never commit .env or real API credentials.

OPENAI_BASE_URL=https://elm.edina.ac.uk/api/v1
OPENAI_API_KEY=

GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Model configuration
GENTAS_STRATEGY_MODEL=gpt-5.6-sol
GENTAS_TOP_MODEL=gpt-5.6-sol
GENTAS_PYNQ_MODEL=gpt-5.6-sol

# Execution modes
GENTAS_TOP_MODE=deterministic
GENTAS_PYNQ_MODE=deterministic# Copy to .env for local use. Never commit API keys.
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Optional model overrides.
GENTAS_STRATEGY_MODEL=gpt-5.6-sol
GENTAS_TOP_MODEL=gpt-5.6-sol
GENTAS_PYNQ_MODEL=gpt-5.6-sol
